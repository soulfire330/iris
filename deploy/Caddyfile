# Фаза 4: заменить example.com на свой домен (две A-записи: hub.<домен>, turn.<домен>)

hub.example.com {
	# LiveKit SDK стучится на wss://hub.<домен>/rtc
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}
	reverse_proxy backend:8090
}

# Сайт-заглушка только для выпуска сертификата TURN по HTTP-01.
# LiveKit читает файлы серта из volume caddy_data (см. livekit.yaml).
turn.example.com {
	respond 404
}
