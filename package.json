{
  "name": "office",
  "private": true,
  "scripts": {
    "infra:up": "docker compose -f deploy/docker-compose.yml up -d redis livekit-server livekit-egress",
    "infra:down": "docker compose -f deploy/docker-compose.yml down",
    "infra:logs": "docker compose -f deploy/docker-compose.yml logs -f livekit-server",
    "backend": "cd server && go run . -config ../config.yaml",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "hashpass": "cd server && go run ./cmd/hashpass",
    "stack:up": "docker compose -f deploy/docker-compose.yml up -d --build",
    "stack:down": "docker compose -f deploy/docker-compose.yml down",
    "dev": "bun run infra:up && bun run --parallel backend web:dev"
  }
}
