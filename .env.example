# Секретарь (AI-сводки): OpenAI-совместимые STT и LLM.
# Скопируй в .env (в .gitignore) — docker compose подхватит сам:
#   cp .env.example .env
# Без .env воркер ждёт настройки, остальной стек работает как раньше.
# Сводка после разбора появится в табе «Сводки» у записи.

# Распознавание речи (Whisper/GigaAM и пр.): https://<host> или https://<host>/v1
# (воркер сам добавит /v1, если его нет) — метод /v1/audio/transcriptions
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Генерация сводки: https://<host> или https://<host>/v1 — метод /v1/chat/completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Публичный API: записи, сводки и статус комнаты (заголовок X-API-Key).
# Сгенерируй: openssl rand -hex 32
# Ключ не задан — /api/public/* отвечает 404 (фича выключена).
PUBLIC_API_KEY=
